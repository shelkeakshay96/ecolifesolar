<?php

/**
 * Environment configuration template.
 *
 * Copy to env.php and fill in. env.php is gitignored and must never be
 * committed -- it is the only file in the project holding a password.
 *
 * Anything in here differs between the developer's machine and the server.
 * Anything that does not belong in app/etc/config.php or core_config.
 */

declare(strict_types=1);

return [
    'db' => [
        'host'     => 'localhost',
        'port'     => 3306,
        'name'     => 'ecolife',
        'user'     => '',
        'password' => '',
        'charset'  => 'utf8mb4',
    ],

    // The admin URL segment. Change it and /admin stops existing.
    'backend' => [
        'front_name' => 'admin',
    ],

    'mail' => [
        // 'file' writes .eml files to var/log/mail/ and sends nothing.
        // 'smtp' uses the settings below.
        'transport' => 'file',
        'from'      => ['address' => '', 'name' => 'Eco Life'],
        'smtp'      => [
            'host'       => '',
            'port'       => 587,
            'encryption' => 'tls',
            'user'       => '',
            'password'   => '',
        ],
    ],

    'dev' => [
        // Never true on a public server.
        'display_errors' => false,
    ],
];
