<?php
/**
 * One template, four towns.
 *
 * Which town is decided by the pages.php identifier the controller passed in,
 * so adding a fifth is an entry in Cms/etc/pages.php plus an entry in
 * Cms\Block\Page::getServiceAreas() -- no template, no controller, no route.
 *
 * The completed-projects strip is filtered on the town name appearing in the
 * gallery item's location, so a town we have not worked in yet simply carries
 * no strip rather than an empty one.
 *
 * @var \EcoLife\Cms\Block\Page $block
 */
$area = $block->getServiceArea();

if ($area === null) {
    return;
}

$whatsapp = $block->getWhatsappLink();
