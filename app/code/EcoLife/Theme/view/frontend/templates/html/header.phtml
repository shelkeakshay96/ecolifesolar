<?php
/**
 * Public site header.
 *
 * Every contact detail here comes from core_config, never from this file. The
 * family cannot edit templates, so a phone number hardcoded in markup is a
 * phone number they can never correct.
 *
 * The dark pine bar with the gold underline nav is carried over from the v3.1
 * static site; the shrink-on-scroll behaviour is a single .is-stuck class,
 * added by app.js and styled in input.css.
 *
 * @var \EcoLife\Core\View\Element\Template $block
 */
$phones   = $block->getContactNumbers();
$business = $block->getSetting('general/business/name', 'Eco Life');
$current  = $block->getRequest()->getPathInfo();

/*
 * One array, rendered twice -- the desktop bar and the mobile drawer both loop
 * over it. That matters: the Blog stub that used to sit here was hardcoded
 * after the desktop loop instead of being a member of this array, so it existed
 * on wide screens and silently did not exist on phones, which is most of this
 * audience. Anything that belongs in the navigation belongs in here.
 */
$links = [
    '/'           => 'Home',
    '/services'   => 'Solutions',
    '/about'      => 'Why Eco Life',
    '/calculator' => 'Calculator',
    '/gallery'    => 'Our Work',
    '/faq'        => 'FAQ',
    '/contact'    => 'Contact',
];
?>
<header class="site-header sticky top-0 z-50 border-b border-gold-300/30 bg-pine-900/95 backdrop-blur"
        data-site-header>

    <div class="section-shell flex items-center justify-between gap-4 py-2">

        <a href="/" class="flex shrink-0 items-center gap-3 py-1.5" aria-label="<?= $block->escapeHtmlAttr($business) ?> — home">
            <img src="<?= $block->escapeUrl($block->getStaticUrl('images/logo.png')) ?>"
                 alt="<?= $block->escapeHtmlAttr($business) ?>" class="site-logo w-auto">
        </a>

        <nav class="hidden items-center gap-7 xl:flex" aria-label="Primary">
            <?php foreach ($links as $href => $label): ?>
                <a href="<?= $block->escapeUrl($href) ?>"
                   class="nav-link text-[.83rem] whitespace-nowrap <?= $block->escapeHtmlAttr($current === $href
                       ? 'text-pearl' : 'text-pine-100 hover:text-pearl') ?>"
                   aria-current="<?= $block->escapeHtmlAttr($current === $href ? 'page' : 'false') ?>">
                    <?= $block->escapeHtml($label) ?>
                </a>
            <?php endforeach; ?>
        </nav>

        <div class="flex items-center gap-3">
            <?php /* Every number, stacked. One icon for the group rather than one per
                     line: repeating it down the column reads as a list of different
                     things rather than one way of reaching us. Each line is still its
                     own link, so each dials only itself.

                     Two lines of .75rem sit inside the logo's height, so the bar does
                     not grow. Three would; if it ever comes to that, the answer is to
                     drop this to the primary number and leave the rest to the menu. */ ?>
            <?php if ($phones !== []): ?>
                <div class="hidden items-center gap-2 text-gold-300 sm:flex">
                    <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M2.25 6.75c0 8.28 6.72 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.37a1.13 1.13 0 0 0-.85-1.09l-4.42-1.1a1.12 1.12 0 0 0-1.17.42l-.97 1.29a13.5 13.5 0 0 1-6.02-6.02l1.3-.97c.38-.29.54-.76.42-1.17l-1.11-4.42a1.13 1.13 0 0 0-1.09-.85H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"/>
                    </svg>
                    <span class="flex flex-col leading-[1.45]">
                        <?php foreach ($phones as $phone): ?>
                            <a href="tel:<?= $block->escapeHtmlAttr($phone['dial']) ?>"
                               class="font-mono text-[.75rem] whitespace-nowrap transition hover:text-gold-200">
                                <?= $block->escapeHtml($phone['display']) ?>
                            </a>
                        <?php endforeach; ?>
                    </span>
                </div>
            <?php endif; ?>

            <a href="/contact" class="btn-gold btn-compact hidden sm:inline-flex" data-magnetic="0.18">
                Get Free Quote
            </a>

            <button type="button"
                    class="rounded-full border border-gold-500/70 px-4 py-2 font-mono text-[.72rem] text-gold-300
                           transition hover:bg-gold-500 hover:text-pine-950 xl:hidden"
                    data-mobile-nav-toggle
                    aria-controls="mobile-nav"
                    aria-expanded="false">
                Menu
            </button>
        </div>
    </div>

    <nav id="mobile-nav" class="hidden border-t border-gold-300/20 bg-pine-900 xl:hidden" aria-label="Mobile">
        <div class="section-shell space-y-1 py-4">
            <?php foreach ($links as $href => $label): ?>
                <a href="<?= $block->escapeUrl($href) ?>"
                   class="block rounded-xl px-4 py-3 text-[.95rem] <?= $block->escapeHtmlAttr($current === $href
                       ? 'bg-pine-800 text-gold-300' : 'text-pine-100 hover:bg-pine-800') ?>">
                    <?= $block->escapeHtml($label) ?>
                </a>
            <?php endforeach; ?>

            <?php /* The header's phone link is hidden below sm, so without this a phone
                     visitor -- almost all of them -- had no number to tap anywhere above
                     the footer. One link per number, each dialling only itself. */ ?>
            <?php if ($phones !== []): ?>
                <div class="mt-4 border-t border-gold-300/20 pt-4">
                    <p class="px-4 font-mono text-[.66rem] uppercase tracking-[.1em] text-pine-100/50">Call us</p>
                    <?php foreach ($phones as $phone): ?>
                        <a href="tel:<?= $block->escapeHtmlAttr($phone['dial']) ?>"
                           class="flex items-center gap-3 rounded-xl px-4 py-3 font-mono text-[.9rem]
                                  text-gold-300 hover:bg-pine-800">
                            <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0" fill="none" stroke="currentColor"
                                 stroke-width="1.8" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M2.25 6.75c0 8.28 6.72 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.37a1.13 1.13 0 0 0-.85-1.09l-4.42-1.1a1.12 1.12 0 0 0-1.17.42l-.97 1.29a13.5 13.5 0 0 1-6.02-6.02l1.3-.97c.38-.29.54-.76.42-1.17l-1.11-4.42a1.13 1.13 0 0 0-1.09-.85H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"/>
                            </svg>
                            <?= $block->escapeHtml($phone['display']) ?>
                        </a>
                    <?php endforeach; ?>
                </div>
            <?php endif; ?>

            <a href="/contact" class="btn-gold mt-3 w-full">Get Free Quote</a>
        </div>
    </nav>
</header>
