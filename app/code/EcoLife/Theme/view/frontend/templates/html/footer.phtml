<?php
/**
 * Public site footer.
 *
 * The original static site shipped with `[add number]` and `[add email]`
 * placeholders still in the markup. Those are now core_config rows, so the
 * family fixes them from the admin panel instead of asking a developer.
 *
 * @var \EcoLife\Core\View\Element\Template $block
 */
$business  = $block->getSetting('general/business/name', 'Eco Life');
$phones    = $block->getContactNumbers();
$whatsapp  = $block->getSetting('general/contact/whatsapp');
$email     = $block->getSetting('general/contact/email');
$address   = $block->getSetting('general/contact/address');
$hours     = $block->getSetting('general/contact/hours');
$gstin     = $block->getSetting('general/business/gstin');
$facebook  = $block->getSetting('general/social/facebook');
$instagram = $block->getSetting('general/social/instagram');
?>
<footer class="mt-20 bg-pine-900 text-pine-100">
    <div class="section-shell py-14">
        <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">

            <div class="lg:pr-6">
                <img src="<?= $block->escapeUrl($block->getStaticUrl('images/logo.png')) ?>"
                     alt="<?= $block->escapeHtmlAttr($business) ?>" class="h-12 w-auto">
                <p class="mt-5 max-w-xs text-[.88rem] leading-relaxed text-pine-100/80">
                    Rooftop solar for homes, housing societies and businesses across Satara
                    and the surrounding district. Water heaters, battery storage and
                    electrical work alongside.
                </p>
                <?php if ($gstin !== ''): ?>
                    <p class="mt-5 font-mono text-[.7rem] text-pine-100/50">GSTIN <?= $block->escapeHtml($gstin) ?></p>
                <?php endif; ?>
            </div>

            <div>
                <h2 class="mb-4 font-mono text-[.72rem] uppercase tracking-[.1em] text-gold-300">Solutions</h2>
                <ul class="space-y-2.5 text-[.88rem]">
                    <?php /* A list, not a map: two of these links point at /services. */ ?>
                    <?php foreach ([['/services', 'Rooftop solar panels'],
                                    ['/services', 'What we install'],
                                    ['/calculator', 'Savings calculator'],
                                    ['/gallery', 'Recent work']] as [$href, $label]): ?>
                        <li>
                            <a class="text-pine-100/85 transition hover:text-pearl" href="<?= $block->escapeUrl($href) ?>">
                                <?= $block->escapeHtml($label) ?>
                            </a>
                        </li>
                    <?php endforeach; ?>
                    <li><a class="text-pine-100/85 transition hover:text-pearl" href="#" data-soon="Solar water heaters">Solar water heaters</a></li>
                    <li><a class="text-pine-100/85 transition hover:text-pearl" href="#" data-soon="Battery storage">Battery storage</a></li>
                </ul>
            </div>

            <div>
                <h2 class="mb-4 font-mono text-[.72rem] uppercase tracking-[.1em] text-gold-300">Company</h2>
                <ul class="space-y-2.5 text-[.88rem]">
                    <li><a class="text-pine-100/85 transition hover:text-pearl" href="/about">Why Eco Life</a></li>
                    <li><a class="text-pine-100/85 transition hover:text-pearl" href="/about">Our process</a></li>
                    <li><a class="text-pine-100/85 transition hover:text-pearl" href="/contact">Request a quote</a></li>
                    <li><a class="text-pine-100/85 transition hover:text-pearl" href="#" data-soon="Blog">Blog</a></li>
                </ul>

                <?php /* This replaces the "Cities we serve" data-soon stub, which was left here
                         for exactly these pages. The list is literal rather than shared with
                         Cms\Block\Page::getServiceAreas() because footer.phtml renders through a
                         bare Template block with no data, and promoting the whole footer to its
                         own block subclass to avoid four hrefs is a poor trade. */ ?>
                <h2 class="mt-7 mb-4 font-mono text-[.72rem] uppercase tracking-[.1em] text-gold-300">Where we work</h2>
                <ul class="space-y-2.5 text-[.88rem]">
                    <?php foreach ([['/solar-in-satara', 'Solar in Satara'],
                                    ['/solar-in-karad', 'Solar in Karad'],
                                    ['/solar-in-wai', 'Solar in Wai'],
                                    ['/solar-in-phaltan', 'Solar in Phaltan']] as [$href, $label]): ?>
                        <li>
                            <a class="text-pine-100/85 transition hover:text-pearl" href="<?= $block->escapeUrl($href) ?>">
                                <?= $block->escapeHtml($label) ?>
                            </a>
                        </li>
                    <?php endforeach; ?>
                </ul>
