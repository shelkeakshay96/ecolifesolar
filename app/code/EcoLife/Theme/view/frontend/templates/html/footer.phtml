                                </dd>
                            <?php endforeach; ?>
                        </div>
                    <?php endif; ?>
                    <?php if ($whatsapp !== ''): ?>
                        <div>
                            <dt class="font-mono text-[.66rem] uppercase tracking-[.08em] text-pine-100/45">WhatsApp</dt>
                            <dd class="mt-0.5"><?= $block->escapeHtml($whatsapp) ?></dd>
                        </div>
                    <?php endif; ?>
                    <?php if ($email !== ''): ?>
                        <div>
                            <dt class="font-mono text-[.66rem] uppercase tracking-[.08em] text-pine-100/45">Email</dt>
                            <dd class="mt-0.5">
                                <a class="transition hover:text-pearl" href="mailto:<?= $block->escapeHtmlAttr($email) ?>">
                                    <?= $block->escapeHtml($email) ?>
                                </a>
                            </dd>
                        </div>
                    <?php endif; ?>
                    <?php if ($address !== ''): ?>
                        <div>
                            <dt class="font-mono text-[.66rem] uppercase tracking-[.08em] text-pine-100/45">Address</dt>
                            <dd class="mt-0.5 leading-relaxed"><?= $block->escapeHtml($address) ?></dd>
                        </div>
                    <?php endif; ?>
                    <?php if ($hours !== ''): ?>
                        <div>
                            <dt class="font-mono text-[.66rem] uppercase tracking-[.08em] text-pine-100/45">Hours</dt>
                            <dd class="mt-0.5"><?= $block->escapeHtml($hours) ?></dd>
                        </div>
                    <?php endif; ?>
                </dl>

                <?php if ($facebook !== '' || $instagram !== ''): ?>
                    <div class="mt-5 flex gap-4 font-mono text-[.75rem]">
                        <?php if ($facebook !== ''): ?>
                            <a href="<?= $block->escapeUrl($facebook) ?>" rel="noopener noreferrer" target="_blank"
                               class="text-pine-100/70 transition hover:text-gold-300">Facebook</a>
                        <?php endif; ?>
                        <?php if ($instagram !== ''): ?>
                            <a href="<?= $block->escapeUrl($instagram) ?>" rel="noopener noreferrer" target="_blank"
                               class="text-pine-100/70 transition hover:text-gold-300">Instagram</a>
                        <?php endif; ?>
                    </div>
                <?php endif; ?>
            </div>
        </div>

        <div class="mt-12 flex flex-wrap items-center justify-between gap-3 border-t border-gold-300/20 pt-6
                    font-mono text-[.72rem] text-pine-100/60">
            <span>&copy; <?= $block->escapeHtml(date('Y')) ?> <?= $block->escapeHtml($business) ?>. All rights reserved.</span>
            <span>Satara, Maharashtra</span>
        </div>
    </div>
</footer>
