                    <?php if ($phones !== []): ?>
                        <div>
                            <dt class="font-mono text-[.66rem] uppercase tracking-[.08em] text-pine-100/45">Phone</dt>
                            <?php /* One <dd> per number: a single dd holding two links would
                                     read as one value to a screen reader, and each needs its
                                     own tap target on a phone anyway. */ ?>
                            <?php foreach ($phones as $phone): ?>
                                <dd class="mt-0.5">
                                    <a class="transition hover:text-pearl" href="tel:<?= $block->escapeHtmlAttr($phone['dial']) ?>">
                                        <?= $block->escapeHtml($phone['display']) ?>
