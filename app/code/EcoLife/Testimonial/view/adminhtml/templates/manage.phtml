<?php
/**
 * Testimonial management: the list and the add form on one screen, mirroring
 * EcoLife_Gallery::manage.phtml.
 *
 * @var \EcoLife\Testimonial\Block\Adminhtml\Manage $block
 */
$testimonials = $block->getTestimonials();
?>
<div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">

    <h1 class="text-2xl font-semibold tracking-tight text-slate-900">Testimonials</h1>
    <p class="mt-1 text-sm text-slate-500">
        Customer quotes shown on the home page. Lower sort order appears first.
        The section is hidden on the website until at least one quote is visible here.
    </p>

    <form method="post" action="<?= $block->escapeUrl($block->getSaveUrl()) ?>" class="card mt-6">
        <input type="hidden" name="form_key" value="<?= $block->escapeHtmlAttr($block->getFormKey()) ?>">

        <h2 class="text-base font-semibold text-slate-900">Add a testimonial</h2>

        <div class="mt-4 grid gap-4 sm:grid-cols-2">
            <div>
                <label class="form-label" for="t-name">Customer name</label>
                <input class="form-input" id="t-name" name="customer_name" type="text" maxlength="120" required
                       placeholder="e.g. Sunil Deshmukh">
            </div>
            <div>
                <label class="form-label" for="t-location">Town or area</label>
                <input class="form-input" id="t-location" name="location" type="text" maxlength="100"
                       placeholder="e.g. Karad">
            </div>
            <div>
                <label class="form-label" for="t-size">System size (kW)</label>
                <input class="form-input" id="t-size" name="system_size_kw" type="number" step="0.01" min="0">
                <p class="mt-1 text-xs text-slate-400">Optional. Shown beside the town.</p>
            </div>
            <div>
                <label class="form-label" for="t-language">Language</label>
                <select class="form-input" id="t-language" name="language">
                    <?php foreach ($block->getLanguages() as $value => $label): ?>
                        <option value="<?= $block->escapeHtmlAttr($value) ?>"><?= $block->escapeHtml($label) ?></option>
                    <?php endforeach; ?>
                </select>
                <p class="mt-1 text-xs text-slate-400">Marathi quotes are marked up as Marathi for screen readers.</p>
            </div>
            <div>
                <label class="form-label" for="t-sort">Sort order</label>
                <input class="form-input" id="t-sort" name="sort_order" type="number" value="0">
            </div>
            <div class="flex items-end">
                <label class="flex items-center gap-2 text-sm">
                    <input type="checkbox" name="is_active" value="1" checked>
                    <span>Show on the website</span>
                </label>
            </div>
        </div>

        <div class="mt-4">
            <label class="form-label" for="t-quote">What they said</label>
            <textarea class="form-input" id="t-quote" name="quote" rows="3" maxlength="1000" required
                      placeholder="Their own words. Do not tidy them up too much -- a real sentence reads as real."></textarea>
        </div>

        <button type="submit" class="btn-primary mt-5">Add testimonial</button>
    </form>

    <div class="card mt-8 p-0">
        <h2 class="border-b border-slate-200 px-6 py-4 text-base font-semibold text-slate-900">
            <?= $block->escapeHtml((string) count($testimonials)) ?> testimonial(s)
        </h2>

        <?php if ($testimonials === []): ?>
            <p class="px-6 py-10 text-center text-sm text-slate-500">
                No testimonials yet. The home page shows no testimonial section at all until there is one.
            </p>
        <?php else: ?>
            <ul class="divide-y divide-slate-100">
                <?php foreach ($testimonials as $testimonial): ?>
                    <li class="flex flex-wrap items-start gap-4 px-6 py-4">
                        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full
                                     bg-slate-100 text-sm font-semibold text-slate-600">
                            <?= $block->escapeHtml($testimonial->getInitial()) ?>
                        </span>

                        <div class="min-w-0 flex-1">
                            <p class="text-sm text-slate-700">&ldquo;<?= $block->escapeHtml($testimonial->getQuote()) ?>&rdquo;</p>
                            <p class="mt-1 text-sm font-medium text-slate-900"><?= $block->escapeHtml($testimonial->getCustomerName()) ?></p>
                            <p class="text-sm text-slate-500"><?= $block->escapeHtml($testimonial->getMetaLabel()) ?></p>
                        </div>

                        <span class="rounded-full px-2 py-0.5 text-xs font-medium <?= $block->escapeHtmlAttr($testimonial->isActive()
                            ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-500') ?>">
                            <?= $block->escapeHtml($testimonial->isActive() ? 'Visible' : 'Hidden') ?>
                        </span>

                        <span class="text-xs text-slate-400">order <?= $block->escapeHtml((string) $testimonial->getData('sort_order')) ?></span>

                        <?php /* data-confirm rather than onsubmit: an inline handler is script,
                                 and script-src 'self' drops it silently. app.js binds this. */ ?>
                        <form method="post" action="<?= $block->escapeUrl($block->getDeleteUrl($testimonial)) ?>"
                              data-confirm="Remove this testimonial?">
                            <input type="hidden" name="form_key" value="<?= $block->escapeHtmlAttr($block->getFormKey()) ?>">
                            <button type="submit" class="text-sm font-medium text-red-600 hover:text-red-500">Remove</button>
                        </form>
                    </li>
                <?php endforeach; ?>
            </ul>
        <?php endif; ?>
    </div>
</div>
