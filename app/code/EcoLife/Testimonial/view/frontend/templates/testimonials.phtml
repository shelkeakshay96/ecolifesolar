<?php
/**
 * Customer quotes.
 *
 * The early return is the point of this template. With no active rows it emits
 * nothing at all -- not an empty state, not a "testimonials coming soon" card,
 * and certainly not invented quotes. The competitor comparison found that our
 * honest, specific copy was the one thing already beating theirs; three
 * plausible-sounding fake customers would have spent exactly that.
 *
 * @var \EcoLife\Testimonial\Block\Testimonials $block
 */
$testimonials = $block->getTestimonials();

if ($testimonials === []) {
    return;
}
?>
<section class="section-shell py-20 lg:py-24">
    <div class="reveal">
        <p class="eyebrow"><span class="opacity-60">/05</span> In their words</p>
        <h2 class="mt-3 text-3xl sm:text-4xl">What people in Satara say afterwards</h2>
    </div>

    <?php /* Two across, not three. The portrait is the point of this section -- a
             stranger's face beside their own words is the whole reason a testimonial
             carries more than the same sentence in our voice -- and a third column
             squeezes it back to a token avatar. */ ?>
    <div class="mt-12 grid gap-6 lg:grid-cols-2" data-reveal-stagger="100">
        <?php foreach ($testimonials as $testimonial): ?>
            <figure class="reveal card-lift flex overflow-hidden rounded-2xl border border-sand
                           border-t-2 border-t-gold-500 bg-white">

                <?php /* The portrait is a full-height panel, so it stays the same size no
                         matter how long the quote runs and the row of cards keeps a straight
                         left edge. object-top because a head sits near the top of a portrait
                         and object-cover would otherwise crop the forehead first. */ ?>
                <?php if ($testimonial->photoExists()): ?>
                    <img src="<?= $block->escapeUrl($block->getMediaUrl($testimonial->getPhotoPath())) ?>"
                         alt="<?= $block->escapeHtmlAttr($testimonial->getCustomerName()) ?>"
                         class="w-28 shrink-0 self-stretch object-cover object-top sm:w-36 lg:w-40"
                         loading="lazy" width="160" height="220">
                <?php else: ?>
                    <?php /* Their initial, never a stock portrait. A stranger's face above a
                             real person's name is the one thing on this page that would
                             actually be a lie. Same footprint as the photo, so a card with no
                             photograph does not sit shorter than the one beside it. */ ?>
                    <span class="flex w-28 shrink-0 items-center justify-center self-stretch
                                 bg-pine-100 font-display text-5xl font-semibold text-pine-700 sm:w-36 lg:w-40">
                        <?= $block->escapeHtml($testimonial->getInitial()) ?>
                    </span>
                <?php endif; ?>

                <div class="flex min-w-0 flex-1 flex-col p-5 sm:p-6">
                    <svg viewBox="0 0 32 32" class="h-6 w-6 shrink-0 text-gold-400" fill="currentColor" aria-hidden="true">
                        <path d="M13 8v6.5c0 4.7-2.8 8.1-7 9.5l-1-2.4c2.6-1 4.2-2.8 4.5-5.1H5V8h8Zm14 0v6.5c0 4.7-2.8 8.1-7 9.5l-1-2.4c2.6-1 4.2-2.8 4.5-5.1H19V8h8Z"/>
                    </svg>

                    <?php /* lang= so a screen reader pronounces a Marathi quote as Marathi
                             rather than reading Devanagari through an English voice. */ ?>
                    <blockquote class="mt-3 flex-1 text-[.95rem] leading-relaxed text-ink"
                                lang="<?= $block->escapeHtmlAttr($testimonial->getLanguage()) ?>">
                        <?= $block->escapeHtml($testimonial->getQuote()) ?>
                    </blockquote>

                    <?php /* Three lines at most, and the byline drops whichever it has not
                             got. Business gets its own line rather than joining the meta run
                             because for a commercial job it is the credential -- "Santkrupa
                             Dairy" is something a reader can go and check, in a way that
                             "Karad" is not. */ ?>
                    <figcaption class="mt-5 border-t border-sand pt-4">
                        <span class="block text-[.95rem] font-semibold text-ink">
                            <?= $block->escapeHtml($testimonial->getCustomerName()) ?>
                        </span>
                        <?php if ($testimonial->getBusiness() !== ''): ?>
                            <span class="block truncate text-[.85rem] text-pine-600">
                                <?= $block->escapeHtml($testimonial->getBusiness()) ?>
                            </span>
                        <?php endif; ?>
                        <?php if ($testimonial->getMetaLabel() !== ''): ?>
                            <span class="mt-0.5 block font-mono text-[.7rem] uppercase tracking-[.08em] text-muted">
                                <?= $block->escapeHtml($testimonial->getMetaLabel()) ?>
                            </span>
                        <?php endif; ?>
                    </figcaption>
                </div>
            </figure>
        <?php endforeach; ?>
    </div>
</section>
