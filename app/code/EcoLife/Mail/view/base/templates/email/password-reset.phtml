<?php
/**
 * The password reset email.
 *
 * Table layout and inline styles, like every other email here: mail clients
 * have no useful CSS support and Outlook still renders through Word.
 *
 * The link is written out as text underneath the button as well. Plenty of
 * clients strip or mangle a styled anchor, and a reset email whose only route
 * to the site is a button that did not render is a support call.
 *
 * @var \EcoLife\Core\View\Element\Template $block
 */
$name    = (string) $block->getData('name', '');
$url     = (string) $block->getData('reset_url', '');
$minutes = (int) $block->getData('valid_minutes', 60);
?>
<table width="100%" cellpadding="0" cellspacing="0" border="0"
       style="background:#F4F0E4;padding:24px 0;font-family:Arial,Helvetica,sans-serif;">
    <tr>
        <td align="center">
            <table width="560" cellpadding="0" cellspacing="0" border="0"
                   style="max-width:560px;background:#FDFBF6;border:1px solid #E4DFCF;border-radius:8px;">

                <tr>
                    <td style="background:#0F2A14;padding:20px 28px;border-radius:8px 8px 0 0;">
                        <span style="color:#FFCB66;font-size:13px;letter-spacing:1px;text-transform:uppercase;">
                            EcoLifeSolar admin
                        </span>
                    </td>
                </tr>

                <tr>
                    <td style="padding:28px;color:#1B2620;font-size:15px;line-height:1.6;">
                        <p style="margin:0 0 16px;">
                            Hello <?= $block->escapeHtml($name) ?>,
                        </p>

                        <p style="margin:0 0 16px;">
                            Somebody asked to reset the password for your EcoLifeSolar admin
                            account. Use the button below to choose a new one.
                        </p>

                        <p style="margin:0 0 24px;">
                            <a href="<?= $block->escapeUrl($url) ?>"
                               style="display:inline-block;background:#F0A500;color:#0F2A14;
                                      text-decoration:none;font-weight:bold;font-size:15px;
                                      padding:12px 24px;border-radius:6px;">
                                Set a new password
                            </a>
                        </p>

                        <p style="margin:0 0 24px;color:#5B6B60;font-size:13px;line-height:1.5;">
                            If the button does not work, copy this address into your browser:<br>
                            <span style="color:#256B2A;word-break:break-all;">
                                <?= $block->escapeHtml($url) ?>
                            </span>
                        </p>

                        <p style="margin:0 0 16px;color:#5B6B60;font-size:13px;">
                            This link stops working in <?= $block->escapeHtml((string) $minutes) ?> minutes,
                            and can only be used once.
                        </p>

                        <p style="margin:0;color:#5B6B60;font-size:13px;">
                            <strong>If you did not ask for this</strong>, you can ignore this email
                            &mdash; your password has not changed. If it keeps arriving, tell whoever
                            looks after the website.
                        </p>
                    </td>
                </tr>

                <tr>
                    <td style="padding:16px 28px;border-top:1px solid #E4DFCF;color:#5B6B60;font-size:12px;">
                        Sent automatically by the EcoLifeSolar admin panel. Nobody reads replies to
                        this address.
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
