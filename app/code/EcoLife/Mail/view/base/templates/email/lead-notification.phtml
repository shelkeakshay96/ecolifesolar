<?php
/**
 * Internal notification for a new enquiry.
 *
 * Table-based layout with inline styles on purpose: this has to survive Gmail
 * on an Android phone, which is where it will actually be read. No stylesheet,
 * no external images.
 *
 * @var \EcoLife\Core\View\Element\Template $block
 * @var \EcoLife\Lead\Model\Lead $lead
 */
$lead = $block->getData('lead');

$rows = array_filter([
    'Enquiry type' => $lead->getTypeLabel(),
    'Name'         => $lead->getName(),
    'Phone'        => $lead->getPhone(),
    'Email'        => $lead->getEmail(),
    'City'         => $lead->getCity() . ' ' . (string) $lead->getData('pincode'),
    'Monthly bill' => $lead->getBillRangeLabel(),
    'Roof type'    => $lead->getRoofTypeLabel(),
    'Roof area'    => $lead->getData('roof_area_sqft') ? $lead->getData('roof_area_sqft') . ' sq ft' : '',
    'Society'      => (string) $lead->getData('society_name'),
    'Flats'        => (string) $lead->getData('total_flats'),
    'Business'     => (string) $lead->getData('company_name'),
    'GSTIN'        => (string) $lead->getData('gstin'),
    'Message'      => (string) $lead->getData('message'),
    'Came from'    => (string) $lead->getData('source_page'),
], static fn($v) => trim((string) $v) !== '');
?>
<div style="margin:0;padding:24px;background:#f8fafc;font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:#334155;">
  <table role="presentation" cellpadding="0" cellspacing="0" style="max-width:560px;margin:0 auto;background:#ffffff;border:1px solid #e2e8f0;border-radius:12px;">
    <tr>
      <td style="padding:24px 24px 8px;">
        <p style="margin:0;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#d97706;">New enquiry</p>
        <h1 style="margin:8px 0 0;font-size:20px;color:#0f172a;">
          <?= $block->escapeHtml($lead->getName()) ?>
        </h1>
        <p style="margin:4px 0 0;font-size:14px;color:#64748b;">
          <?= $block->escapeHtml($lead->getTypeLabel()) ?> &middot; <?= $block->escapeHtml($lead->getCity()) ?>
        </p>
      </td>
    </tr>

    <tr>
      <td style="padding:16px 24px;">
        <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="font-size:14px;">
          <?php foreach ($rows as $label => $value): ?>
            <tr>
              <td style="padding:6px 0;color:#94a3b8;width:38%;vertical-align:top;">
                <?= $block->escapeHtml($label) ?>
              </td>
              <td style="padding:6px 0;color:#0f172a;">
                <?= $block->escapeHtml($value) ?>
              </td>
            </tr>
          <?php endforeach; ?>
        </table>
      </td>
    </tr>

    <tr>
      <td style="padding:8px 24px 24px;">
        <a href="tel:<?= $block->escapeHtmlAttr($lead->getPhone()) ?>"
           style="display:inline-block;background:#f59e0b;color:#ffffff;text-decoration:none;padding:10px 18px;border-radius:8px;font-size:14px;font-weight:500;">
          Call <?= $block->escapeHtml($lead->getPhone()) ?>
        </a>
        <p style="margin:16px 0 0;font-size:12px;color:#94a3b8;">
          Received <?= $block->escapeHtml($block->formatDate((string) $lead->getData('created_at'), 'd M Y \a\t H:i')) ?>.
          Reply to this email to answer the customer directly.
        </p>
      </td>
    </tr>
  </table>
</div>
