<?php
/**
 * The question list, pulled onto the FAQ page with renderChild().
 *
 * Plain <details>, no JavaScript, and every answer written into the HTML
 * whether or not it is expanded. That is the whole point: a crawler reads the
 * markup and not the open state, and an accordion that fetches or templates its
 * content on click ships a page with no answers on it. The move from a PHP
 * array to a database table changed where the text comes from and nothing about
 * how it reaches the page.
 *
 * @var \EcoLife\Faq\Block\Faqs $block
 */
$faqs = $block->getFaqs();
?>
<?php if ($faqs === []): ?>
    <p class="text-sm text-muted">No questions have been published yet.</p>
<?php else: ?>
    <div class="mx-auto max-w-3xl divide-y divide-sand border-y border-sand" data-reveal-stagger="60">
        <?php foreach ($faqs as $faq): ?>
            <details class="reveal group py-5">
                <summary class="flex cursor-pointer items-start gap-3 text-[1.02rem] font-semibold text-ink
                                marker:content-none [&::-webkit-details-marker]:hidden">
                    <span class="mt-1 font-mono text-[.8rem] text-gold-600 transition group-open:rotate-45">+</span>
                    <span><?= $block->escapeHtml($faq->getQuestion()) ?></span>
                </summary>
                <div class="mt-3 pl-7">
                    <p class="text-[.93rem] leading-relaxed text-muted"><?= $block->escapeHtml($faq->getAnswer()) ?></p>
                    <?php if ($faq->hasLink()): ?>
                        <a href="<?= $block->escapeUrl($faq->getLinkUrl()) ?>"
                           class="mt-3 inline-block font-mono text-[.78rem] uppercase tracking-[.08em]
                                  text-pine-600 underline decoration-gold-400 underline-offset-4
                                  transition hover:text-gold-600">
                            <?= $block->escapeHtml($faq->getLinkLabel()) ?>
                        </a>
                    <?php endif; ?>
                </div>
            </details>
        <?php endforeach; ?>
    </div>
<?php endif; ?>
