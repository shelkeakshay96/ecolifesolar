                            <span class="text-xs text-slate-400">order <?= $block->escapeHtml((string) $faq->getData('sort_order')) ?></span>

                            <?php /* data-confirm rather than onsubmit: an inline handler is script,
                                     and script-src 'self' drops it silently. app.js binds this. */ ?>
                            <form method="post" action="<?= $block->escapeUrl($block->getDeleteUrl($faq)) ?>"
                                  data-confirm="Remove this question?">
