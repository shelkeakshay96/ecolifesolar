                                <div>
                                    <label class="form-label" for="e-question-<?= $block->escapeHtmlAttr($id) ?>">Question</label>
                                    <input class="form-input" id="e-question-<?= $block->escapeHtmlAttr($id) ?>"
                                           name="question" type="text" maxlength="255" required
                                           value="<?= $block->escapeHtmlAttr($faq->getQuestion()) ?>">
                                </div>

                                <div class="mt-4">
                                    <label class="form-label" for="e-answer-<?= $block->escapeHtmlAttr($id) ?>">Answer</label>
                                    <textarea class="form-input" id="e-answer-<?= $block->escapeHtmlAttr($id) ?>"
                                              name="answer" rows="5" required><?= $block->escapeHtml($faq->getRawAnswer()) ?></textarea>
                                </div>

                                <div class="mt-4 grid gap-4 sm:grid-cols-2">
                                    <div>
                                        <label class="form-label" for="e-link-url-<?= $block->escapeHtmlAttr($id) ?>">Link address</label>
                                        <input class="form-input" id="e-link-url-<?= $block->escapeHtmlAttr($id) ?>"
                                               name="link_url" type="text" maxlength="255"
                                               value="<?= $block->escapeHtmlAttr($faq->getLinkUrl()) ?>">
                                    </div>
                                    <div>
                                        <label class="form-label" for="e-link-label-<?= $block->escapeHtmlAttr($id) ?>">Link text</label>
                                        <input class="form-input" id="e-link-label-<?= $block->escapeHtmlAttr($id) ?>"
                                               name="link_label" type="text" maxlength="120"
                                               value="<?= $block->escapeHtmlAttr($faq->getLinkLabel()) ?>">
                                    </div>
                                    <div>
                                        <label class="form-label" for="e-sort-<?= $block->escapeHtmlAttr($id) ?>">Sort order</label>
                                        <input class="form-input" id="e-sort-<?= $block->escapeHtmlAttr($id) ?>"
                                               name="sort_order" type="number" step="10"
