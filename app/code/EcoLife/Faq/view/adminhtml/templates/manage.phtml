                                <?php if ($faq->hasLink()): ?>
                                    <p class="mt-1 text-xs text-slate-400">
                                        Link: <?= $block->escapeHtml($faq->getLinkLabel()) ?>
                                        &rarr; <?= $block->escapeHtml($faq->getLinkUrl()) ?>
                                    </p>
                                <?php endif; ?>
                            </div>

                            <span class="rounded-full px-2 py-0.5 text-xs font-medium <?= $block->escapeHtmlAttr($faq->isActive()
                                ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-500') ?>">
                                <?= $block->escapeHtml($faq->isActive() ? 'Visible' : 'Hidden') ?>
