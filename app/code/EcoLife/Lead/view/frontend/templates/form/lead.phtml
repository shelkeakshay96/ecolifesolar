<?php
/**
 * The enquiry form.
 *
 * This replaces the form on the original site, which displayed a "Thank you"
 * message and sent nobody's details anywhere. Everything here posts to a real
 * controller, is validated server-side, and lands in the lead table.
 *
 * The card, the tab strip and the chip groups are the original design. What is
 * different underneath: the tabs and chips are radio inputs rather than divs
 * with click handlers, so the whole form is keyboard-operable, announces
 * itself correctly, and still switches between enquiry types with JavaScript
 * off -- the visibility rules are :has() selectors in input.css.
 *
 * @var \EcoLife\Lead\Block\Form $block
 */
$source = $block->getSource();
$id     = 'lead-form-' . $source;
?>
<form id="<?= $block->escapeHtmlAttr($id) ?>" method="post" action="<?= $block->escapeUrl($block->getPostUrl()) ?>"
      class="lead-form overflow-hidden rounded-2xl border border-sand bg-pearl shadow-eco-lg"
      data-lead-form novalidate>

    <input type="hidden" name="form_key" value="<?= $block->escapeHtmlAttr($block->getFormKey()) ?>">
    <input type="hidden" name="<?= $block->escapeHtmlAttr($block->getTimestampField()) ?>"
           value="<?= $block->escapeHtmlAttr($block->getRenderedAt()) ?>">
    <input type="hidden" name="source_page" value="<?= $block->escapeHtmlAttr($source) ?>">
    <?php foreach (['source', 'medium', 'campaign'] as $utm): ?>
        <?php if ($block->getUtm($utm) !== ''): ?>
            <input type="hidden" name="utm_<?= $block->escapeHtmlAttr($utm) ?>"
                   value="<?= $block->escapeHtmlAttr($block->getUtm($utm)) ?>">
        <?php endif; ?>
    <?php endforeach; ?>

    <?php /* Honeypot. Hidden from people, irresistible to bots. */ ?>
    <div class="absolute -left-[9999px]" aria-hidden="true">
        <label for="<?= $block->escapeHtmlAttr($id) ?>-website">Website</label>
        <input id="<?= $block->escapeHtmlAttr($id) ?>-website" type="text" tabindex="-1" autocomplete="off"
               name="<?= $block->escapeHtmlAttr($block->getHoneypotField()) ?>">
    </div>

    <?php /* ------------------------------------------------------ tab strip */ ?>
    <fieldset class="grid grid-cols-3 border-b border-sand bg-pearl-dim">
        <legend class="sr-only">What is this enquiry for?</legend>
        <?php foreach ($block->getTypes() as $value => $label): ?>
            <label class="lead-tab cursor-pointer px-2 py-4 text-center text-[.8rem] font-semibold text-muted">
                <input type="radio" name="lead_type" value="<?= $block->escapeHtmlAttr($value) ?>"
                       class="sr-only" data-lead-type
                       <?= $block->escapeHtmlAttr($value === 'residential' ? 'checked' : '') ?>>
                <?= $block->escapeHtml($label) ?>
            </label>
        <?php endforeach; ?>
    </fieldset>

    <div class="p-6 sm:p-7">

        <h2 class="text-[1.35rem]">Book a free site visit</h2>
        <p class="mt-1.5 text-[.86rem] leading-relaxed text-muted">
            Genuine advice from a local solar advisor. No charge, no obligation —
            we usually reply the same day.
        </p>

        <div data-lead-messages class="mt-4 hidden rounded-xl border px-4 py-3 text-sm" role="status" aria-live="polite"></div>

        <div class="mt-6 grid gap-4 sm:grid-cols-2">
            <div class="sm:col-span-2">
                <label class="form-label" for="<?= $block->escapeHtmlAttr($id) ?>-name">Your name</label>
                <input class="form-input" id="<?= $block->escapeHtmlAttr($id) ?>-name" name="name" type="text"
                       maxlength="150" required autocomplete="name" placeholder="Full name">
                <p class="mt-1.5 hidden text-xs text-red-600" data-error-for="name"></p>
            </div>

            <div>
                <label class="form-label" for="<?= $block->escapeHtmlAttr($id) ?>-phone">Mobile / WhatsApp</label>
                <input class="form-input" id="<?= $block->escapeHtmlAttr($id) ?>-phone" name="phone" type="tel"
                       inputmode="numeric" maxlength="15" required autocomplete="tel" placeholder="10 digits">
                <p class="mt-1.5 hidden text-xs text-red-600" data-error-for="phone"></p>
            </div>

            <div>
                <label class="form-label" for="<?= $block->escapeHtmlAttr($id) ?>-email">
                    Email <span class="normal-case tracking-normal text-muted/60">(optional)</span>
                </label>
                <input class="form-input" id="<?= $block->escapeHtmlAttr($id) ?>-email" name="email" type="email"
                       maxlength="190" autocomplete="email" placeholder="you@example.com">
                <p class="mt-1.5 hidden text-xs text-red-600" data-error-for="email"></p>
            </div>

            <div>
                <label class="form-label" for="<?= $block->escapeHtmlAttr($id) ?>-city">City or village</label>
                <input class="form-input" id="<?= $block->escapeHtmlAttr($id) ?>-city" name="city" type="text"
                       maxlength="100" required value="Satara">
                <p class="mt-1.5 hidden text-xs text-red-600" data-error-for="city"></p>
            </div>

            <div>
                <label class="form-label" for="<?= $block->escapeHtmlAttr($id) ?>-pincode">PIN code</label>
                <input class="form-input" id="<?= $block->escapeHtmlAttr($id) ?>-pincode" name="pincode" type="text"
