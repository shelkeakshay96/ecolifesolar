            </div>
        </div>

        <?php /* ------------------------------------------------- bill + roof */ ?>
        <div class="mt-5">
            <span class="form-label">Average monthly electricity bill</span>
            <div class="flex flex-wrap gap-2">
                <label class="chip">
                    <input type="radio" name="monthly_bill_range" value="" class="sr-only" checked>
