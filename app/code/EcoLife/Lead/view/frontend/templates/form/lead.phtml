                        <?= $block->escapeHtml($label) ?>
                    </label>
                <?php endforeach; ?>
            </div>
        </div>

        <div class="mt-5 grid gap-4 sm:grid-cols-2">
            <div>
                <label class="form-label" for="<?= $block->escapeHtmlAttr($id) ?>-roof">Roof type</label>
                <select class="form-input" id="<?= $block->escapeHtmlAttr($id) ?>-roof" name="roof_type">
                    <option value="">Not sure</option>
                    <?php foreach ($block->getRoofTypes() as $value => $label): ?>
                        <option value="<?= $block->escapeHtmlAttr($value) ?>"><?= $block->escapeHtml($label) ?></option>
                    <?php endforeach; ?>
                </select>
            </div>
            <div>
                <label class="form-label" for="<?= $block->escapeHtmlAttr($id) ?>-area">
                    Roof area, sq ft <span class="normal-case tracking-normal text-muted/60">(optional)</span>
                </label>
                <input class="form-input" id="<?= $block->escapeHtmlAttr($id) ?>-area" name="roof_area_sqft"
                       type="text" inputmode="numeric" maxlength="7">
