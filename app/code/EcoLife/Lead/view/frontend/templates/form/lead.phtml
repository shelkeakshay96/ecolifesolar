                <p class="mt-1.5 hidden text-xs text-red-600" data-error-for="company_name"></p>
            </div>
            <div>
                <label class="form-label" for="<?= $block->escapeHtmlAttr($id) ?>-gstin">
                    GSTIN <span class="normal-case tracking-normal text-muted/60">(optional)</span>
