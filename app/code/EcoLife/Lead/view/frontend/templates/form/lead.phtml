                <p class="mt-1.5 hidden text-xs text-red-600" data-error-for="pincode"></p>
            </div>
        </div>

        <?php /* ------------------------------------------------- society only */ ?>
        <div class="mt-4 gap-4 sm:grid-cols-2" data-when-type="society">
            <div class="sm:col-span-2">
                <label class="form-label" for="<?= $block->escapeHtmlAttr($id) ?>-society">Name of the housing society</label>
                <input class="form-input" id="<?= $block->escapeHtmlAttr($id) ?>-society" name="society_name"
                       type="text" maxlength="190">
                <p class="mt-1.5 hidden text-xs text-red-600" data-error-for="society_name"></p>
            </div>
            <div>
                <label class="form-label" for="<?= $block->escapeHtmlAttr($id) ?>-agm">Approved at AGM?</label>
                <select class="form-input" id="<?= $block->escapeHtmlAttr($id) ?>-agm" name="agm_status">
                    <option value="">Please choose</option>
                    <?php foreach ($block->getAgmStatuses() as $value => $label): ?>
                        <option value="<?= $block->escapeHtmlAttr($value) ?>"><?= $block->escapeHtml($label) ?></option>
                    <?php endforeach; ?>
                </select>
            </div>
            <div>
                <label class="form-label" for="<?= $block->escapeHtmlAttr($id) ?>-flats">Number of flats</label>
                <input class="form-input" id="<?= $block->escapeHtmlAttr($id) ?>-flats" name="total_flats"
                       type="text" inputmode="numeric" maxlength="5">
            </div>
            <div class="sm:col-span-2">
                <span class="form-label">Your role in the society</span>
                <div class="flex flex-wrap gap-2">
