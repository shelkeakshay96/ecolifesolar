                        <label class="chip">
                            <input type="radio" name="society_designation" class="sr-only"
                                   value="<?= $block->escapeHtmlAttr($value) ?>">
                            <?= $block->escapeHtml($label) ?>
                        </label>
                    <?php endforeach; ?>
                </div>
            </div>
        </div>

        <?php /* ---------------------------------------------- commercial only */ ?>
        <div class="mt-4 gap-4 sm:grid-cols-2" data-when-type="commercial">
            <div>
                <label class="form-label" for="<?= $block->escapeHtmlAttr($id) ?>-company">Business name</label>
                <input class="form-input" id="<?= $block->escapeHtmlAttr($id) ?>-company" name="company_name"
