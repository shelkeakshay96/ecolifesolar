<?php
/**
 * Lead grid.
 *
 * @var \EcoLife\Lead\Block\Adminhtml\Grid $block
 */
$filters = $block->getFilters();
$leads   = $block->getCollection()->getItems();
$total   = $block->getTotalCount();
$page    = $block->getCurrentPage();
$last    = $block->getLastPage();
?>
<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">

    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight text-slate-900">Enquiries</h1>
            <p class="mt-1 text-sm text-slate-500">
                <?= $block->escapeHtml((string) $total) ?> matching
                <?= $block->escapeHtml($total === 1 ? 'enquiry' : 'enquiries') ?>
            </p>
        </div>
        <a href="<?= $block->escapeUrl($block->getExportUrl()) ?>" class="btn-secondary text-sm">Export CSV</a>
    </div>

    <form method="get" action="<?= $block->escapeUrl($block->getUrl('leads')) ?>" class="card mt-6">
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
            <div>
                <label class="form-label" for="f-q">Search</label>
                <input class="form-input" id="f-q" name="q" type="text" placeholder="Name, phone or email"
                       value="<?= $block->escapeHtmlAttr($filters['q']) ?>">
            </div>
            <div>
                <label class="form-label" for="f-status">Status</label>
                <select class="form-input" id="f-status" name="status">
                    <option value="">All</option>
                    <?php foreach ($block->getStatusOptions() as $value => $label): ?>
                        <option value="<?= $block->escapeHtmlAttr($value) ?>"
                            <?= $block->escapeHtmlAttr($filters['status'] === $value ? 'selected' : '') ?>>
                            <?= $block->escapeHtml($label) ?>
                        </option>
                    <?php endforeach; ?>
                </select>
            </div>
            <div>
                <label class="form-label" for="f-type">Type</label>
                <select class="form-input" id="f-type" name="lead_type">
                    <option value="">All</option>
                    <?php foreach ($block->getTypeOptions() as $value => $label): ?>
                        <option value="<?= $block->escapeHtmlAttr($value) ?>"
                            <?= $block->escapeHtmlAttr($filters['lead_type'] === $value ? 'selected' : '') ?>>
                            <?= $block->escapeHtml($label) ?>
                        </option>
                    <?php endforeach; ?>
                </select>
            </div>
            <div>
                <label class="form-label" for="f-from">From</label>
                <input class="form-input" id="f-from" name="from" type="date"
                       value="<?= $block->escapeHtmlAttr($filters['from']) ?>">
            </div>
            <div>
                <label class="form-label" for="f-to">To</label>
                <input class="form-input" id="f-to" name="to" type="date"
                       value="<?= $block->escapeHtmlAttr($filters['to']) ?>">
            </div>
        </div>

        <div class="mt-4 flex gap-2">
            <button type="submit" class="btn-primary text-sm">Apply filters</button>
            <?php if ($block->hasActiveFilters()): ?>
                <a href="<?= $block->escapeUrl($block->getUrl('leads')) ?>" class="btn-secondary text-sm">Clear</a>
            <?php endif; ?>
        </div>
    </form>

    <div class="card mt-6 p-0">
        <?php if ($leads === []): ?>
            <p class="px-6 py-12 text-center text-sm text-slate-500">
                <?= $block->escapeHtml($block->hasActiveFilters()
                    ? 'No enquiries match those filters.'
                    : 'No enquiries yet.') ?>
            </p>
        <?php else: ?>
            <div class="overflow-x-auto">
                <table class="min-w-full text-sm">
                    <thead class="bg-slate-50 text-left text-xs uppercase tracking-wider text-slate-400">
                        <tr>
                            <th class="px-4 py-3 font-medium">Received</th>
                            <th class="px-4 py-3 font-medium">Name</th>
                            <th class="px-4 py-3 font-medium">Phone</th>
                            <th class="px-4 py-3 font-medium">City</th>
                            <th class="px-4 py-3 font-medium">Type</th>
                            <th class="px-4 py-3 font-medium">Bill</th>
                            <th class="px-4 py-3 font-medium">Status</th>
                            <th class="px-4 py-3"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <?php foreach ($leads as $lead): ?>
                            <tr class="hover:bg-slate-50">
                                <td class="whitespace-nowrap px-4 py-3 text-slate-500">
                                    <?= $block->escapeHtml($block->formatDate((string) $lead->getData('created_at'), 'd M Y')) ?>
                                    <span class="block text-xs text-slate-400">
                                        <?= $block->escapeHtml($block->formatDate((string) $lead->getData('created_at'), 'H:i')) ?>
                                    </span>
                                </td>
                                <td class="px-4 py-3 font-medium text-slate-900"><?= $block->escapeHtml($lead->getName()) ?></td>
                                <td class="whitespace-nowrap px-4 py-3"><?= $block->escapeHtml($lead->getPhone()) ?></td>
                                <td class="px-4 py-3"><?= $block->escapeHtml($lead->getCity()) ?></td>
                                <td class="px-4 py-3"><?= $block->escapeHtml($lead->getTypeLabel()) ?></td>
                                <td class="px-4 py-3 text-slate-500"><?= $block->escapeHtml($lead->getBillRangeLabel()) ?></td>
                                <td class="px-4 py-3">
                                    <span class="inline-flex whitespace-nowrap rounded-full px-2 py-0.5 text-xs font-medium <?= $block->escapeHtmlAttr($block->getStatusClass($lead->getStatus())) ?>">
                                        <?= $block->escapeHtml($lead->getStatusLabel()) ?>
                                    </span>
                                </td>
                                <td class="px-4 py-3 text-right">
                                    <a href="<?= $block->escapeUrl($block->getViewUrl($lead)) ?>"
                                       class="text-sm font-medium text-brand-600 hover:text-brand-500">Open</a>
                                </td>
                            </tr>
                        <?php endforeach; ?>
                    </tbody>
                </table>
            </div>

            <?php if ($last > 1): ?>
                <div class="flex items-center justify-between border-t border-slate-200 px-4 py-3 text-sm">
                    <span class="text-slate-500">Page <?= $block->escapeHtml((string) $page) ?> of <?= $block->escapeHtml((string) $last) ?></span>
                    <div class="flex gap-2">
                        <?php if ($page > 1): ?>
                            <a class="btn-secondary text-sm" href="<?= $block->escapeUrl($block->getPageUrl($page - 1)) ?>">Previous</a>
                        <?php endif; ?>
                        <?php if ($page < $last): ?>
                            <a class="btn-secondary text-sm" href="<?= $block->escapeUrl($block->getPageUrl($page + 1)) ?>">Next</a>
                        <?php endif; ?>
                    </div>
                </div>
            <?php endif; ?>
        <?php endif; ?>
    </div>
</div>
