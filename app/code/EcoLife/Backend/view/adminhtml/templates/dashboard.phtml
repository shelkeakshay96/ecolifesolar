<?php
/**
 * Admin dashboard.
 *
 * @var \EcoLife\Backend\Block\Adminhtml\Dashboard $block
 */
$counts       = $block->getLeadCounts();
$recent       = $block->getRecentLeads();
$placeholders = $block->getPlaceholderSettings();
$user         = $block->getCurrentUser();

$cards = [
    ['label' => 'Total enquiries', 'value' => $counts['total']],
    ['label' => 'New, unactioned', 'value' => $counts['new']],
    ['label' => 'Last 7 days',     'value' => $counts['week']],
    ['label' => 'Converted',       'value' => $counts['converted']],
];
?>
<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">

    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight text-slate-900">Dashboard</h1>
            <?php if ($user !== null): ?>
                <p class="mt-1 text-sm text-slate-500">
                    Signed in as <?= $block->escapeHtml($user->getDisplayName()) ?>
                    (<?= $block->escapeHtml($user->getRole()) ?>)
                </p>
            <?php endif; ?>
        </div>
        <a href="<?= $block->escapeUrl($block->getUrl('auth/logout')) ?>" class="btn-secondary text-sm">Sign out</a>
    </div>

    <?php if ($placeholders !== []): ?>
        <div class="mt-6 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
            <p class="font-medium">These details are still placeholders and are showing on the public site:</p>
            <p class="mt-1"><?= $block->escapeHtml(implode(', ', $placeholders)) ?>.</p>
        </div>
    <?php endif; ?>

    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <?php foreach ($cards as $card): ?>
            <div class="card">
                <p class="text-xs uppercase tracking-wider text-slate-400"><?= $block->escapeHtml($card['label']) ?></p>
                <p class="mt-2 text-3xl font-semibold text-slate-900"><?= $block->escapeHtml((string) $card['value']) ?></p>
            </div>
        <?php endforeach; ?>
    </div>

    <div class="card mt-8 p-0">
        <div class="flex items-center justify-between border-b border-slate-200 px-6 py-4">
            <h2 class="text-base font-semibold text-slate-900">Recent enquiries</h2>
            <a href="<?= $block->escapeUrl($block->getUrl('leads')) ?>" class="text-sm font-medium text-brand-600 hover:text-brand-500">
                View all &rarr;
            </a>
        </div>

        <?php if ($recent === []): ?>
            <p class="px-6 py-10 text-center text-sm text-slate-500">
                No enquiries yet. They will appear here as soon as the form on the public site is used.
            </p>
        <?php else: ?>
            <div class="overflow-x-auto">
                <table class="min-w-full text-sm">
                    <thead class="bg-slate-50 text-left text-xs uppercase tracking-wider text-slate-400">
                        <tr>
                            <th class="px-6 py-3 font-medium">Name</th>
                            <th class="px-6 py-3 font-medium">Phone</th>
                            <th class="px-6 py-3 font-medium">City</th>
                            <th class="px-6 py-3 font-medium">Type</th>
                            <th class="px-6 py-3 font-medium">Status</th>
                            <th class="px-6 py-3 font-medium">Received</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <?php foreach ($recent as $lead): ?>
                            <tr class="hover:bg-slate-50">
                                <td class="px-6 py-3 font-medium text-slate-900"><?= $block->escapeHtml($lead['name']) ?></td>
                                <td class="px-6 py-3"><?= $block->escapeHtml($lead['phone']) ?></td>
                                <td class="px-6 py-3"><?= $block->escapeHtml($lead['city']) ?></td>
                                <td class="px-6 py-3"><?= $block->escapeHtml(ucfirst((string) $lead['lead_type'])) ?></td>
                                <td class="px-6 py-3">
                                    <span class="inline-flex rounded-full px-2 py-0.5 text-xs font-medium <?= $block->escapeHtmlAttr($block->getStatusClass((string) $lead['status'])) ?>">
                                        <?= $block->escapeHtml($block->getStatusLabel((string) $lead['status'])) ?>
                                    </span>
                                </td>
                                <td class="px-6 py-3 text-slate-500"><?= $block->escapeHtml($block->formatDate((string) $lead['created_at'], 'd M Y, H:i')) ?></td>
                            </tr>
                        <?php endforeach; ?>
                    </tbody>
                </table>
            </div>
        <?php endif; ?>
    </div>
</div>
