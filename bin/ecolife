#!/usr/bin/env php
<?php

/**
 * EcoLifeSolar command line.
 *
 *   bin/ecolife setup:upgrade
 *   bin/ecolife admin:user:create
 *   bin/ecolife lint:templates
 *
 * Shares app/bootstrap.php with the web entry point, so the CLI sees exactly
 * the same modules, configuration and database as a request does.
 */

declare(strict_types=1);

if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    exit;
}

require dirname(__DIR__) . '/app/bootstrap.php';

exit(\EcoLife\Core\Console\Cli::run($argv));
